---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinuityTrace from '../components/ContinuityTrace.astro';
import { withBase } from '../lib/site';
const entries = (await getCollection('physics')).filter((entry) => entry.data.status === 'published').sort((a,b) => b.data.date.getTime()-a.data.date.getTime() || b.data.id.localeCompare(a.data.id));
const latest = entries[0];
---
<BaseLayout title="Daily advanced theoretical physics" description="A durable ledger for daily theoretical-physics training.">
  <section class="hero shell">
    <div class="eyebrow">Current fracture · {latest?.data.date.toISOString().slice(0,10)}</div>
    <h1>{latest?.data.title ?? 'No published session yet'}</h1>
    <p class="lede">{latest?.data.summary ?? 'Add a validated Markdown entry to begin the ledger.'}</p>
    {latest && <a class="primary-action" href={withBase(`/physics/${latest.data.id}/`, import.meta.env.BASE_URL)}>Begin today’s problem <span>→</span></a>}
  </section>
  <section class="ledger-grid shell">
    <div>
      <p class="section-label">The practice</p>
      <h2>Conversation is temporary. The conceptual trail is not.</h2>
      <p>Each entry preserves the provocation, equations, exercise, response pressure, and continuity signal needed for the next encounter.</p>
    </div>
    <div><p class="section-label">Last fourteen</p><ContinuityTrace entries={entries.slice(0,14)} /></div>
  </section>
</BaseLayout>
