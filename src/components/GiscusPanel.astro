---
const configured = Boolean(
  import.meta.env.PUBLIC_GISCUS_REPO_ID && import.meta.env.PUBLIC_GISCUS_CATEGORY_ID
);
---
<section class="discussion" aria-labelledby="discussion-title">
  <h2 id="discussion-title">Discussion</h2>
  {configured ? (
    <p>GitHub Discussion loading is enabled for this deployment.</p>
  ) : (
    <p>Comments will appear here after giscus repository and category IDs are configured. The article remains fully usable without them.</p>
  )}
</section>
