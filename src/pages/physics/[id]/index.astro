---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GiscusPanel from '../../../components/GiscusPanel.astro';
import { withBase } from '../../../lib/site';
import { articleContext } from '../../../lib/content/navigation';
import type { PhysicsEntry } from '../../../lib/content/types';
export async function getStaticPaths() {
  const entries = await getCollection('physics', ({data}) => data.status !== 'draft');
  return entries.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'physics'> };
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const articlePath = `/physics/${entry.data.id}/`;
const markdownUrl = new URL(withBase(`/physics/${entry.data.id}.md`, base), Astro.site);
const jsonUrl = new URL(withBase(`/physics/${entry.data.id}.json`, base), Astro.site);
const permanentUrl = new URL(withBase(articlePath, base), Astro.site).toString();
const outline = headings.filter((heading) => heading.depth === 2);
const allEntries = await getCollection('physics');
const physicsEntries = allEntries.map((item): PhysicsEntry => ({
  id: item.data.id,
  data: item.data,
}));
const context = articleContext(physicsEntries, entry.data.id);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} canonicalPath={articlePath}>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} />
  <link slot="head" rel="alternate" type="application/json" href={jsonUrl} />
  <article class="article-shell">
    <div class="article-grid">
      <header class="article-header">
        <p class="mono article-id">{entry.data.id}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
        <dl class="article-metadata" aria-label="Note metadata">
          <div><dt>Date</dt><dd><time datetime={entry.data.date.toISOString().slice(0,10)}>{entry.data.date.toISOString().slice(0,10)}</time></dd></div>
          <div><dt>Format</dt><dd>{entry.data.entry_kind.replaceAll('-', ' ')}</dd></div>
          <div><dt>Level</dt><dd>{entry.data.level.replaceAll('-', ' ')}</dd></div>
          <div><dt>Time</dt><dd>{entry.data.estimated_minutes} min</dd></div>
          <div class="metadata-topics"><dt>Topics</dt><dd>{entry.data.domains.map((domain) => domain.replaceAll('-', ' ')).join(' · ')}</dd></div>
        </dl>
        <div hidden>{entry.data.domains.map((domain) => <span data-pagefind-filter="domain">{domain}</span>)}</div>
        {entry.data.status !== 'published' && <aside class={`lifecycle ${entry.data.status}`}>This note is {entry.data.status}.{context.supersededBy && <> Continue with <a href={withBase(`/physics/${context.supersededBy}/`, base)}>{context.supersededBy}</a>.</>}</aside>}
        {context.replaces && <aside class="lifecycle relationship">This note replaces <a href={withBase(`/physics/${context.replaces}/`, base)}>{context.replaces}</a>.</aside>}
      </header>

      {outline.length > 0 && (
        <details class="article-outline" open>
          <summary>Contents <span>{outline.length} sections</span></summary>
          <ol>
            {outline.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </details>
      )}

      <div class="article-body" data-pagefind-body><Content /></div>

      <footer class="article-tools">
        <h2>Cite or reuse this note</h2>
        <p>Use <strong>{entry.data.id}</strong> or its permanent URL when continuing the discussion elsewhere.</p>
        <div class="tool-links"><button type="button" class="copy-value" data-copy-value={permanentUrl}>Copy permanent URL</button><a href={markdownUrl}>Source Markdown</a><a href={jsonUrl}>Machine-readable JSON</a></div>
      </footer>

      <GiscusPanel articleId={entry.data.id} />
    </div>

    <nav class="article-navigation" aria-label="Article navigation">
      <span>{context.previous ? <a rel="prev" href={withBase(`/physics/${context.previous}/`, base)}>← Previous note<br/><strong>{context.previous}</strong></a> : 'First note'}</span>
      <a href={withBase('/archive/', base)}>Archive</a>
      <span>{context.next ? <a rel="next" href={withBase(`/physics/${context.next}/`, base)}>Next note →<br/><strong>{context.next}</strong></a> : 'Latest note'}</span>
    </nav>
  </article>
  <script>
    const tableOfContents = document.querySelector<HTMLDetailsElement>('.article-outline');
    const marginNotes = document.querySelectorAll<HTMLDetailsElement>('.margin-note');
    const wideOutline = window.matchMedia('(min-width: 1540px)');
    const wideMargins = window.matchMedia('(min-width: 1360px)');
    const syncTableOfContents = (matches: boolean) => {
      if (tableOfContents) tableOfContents.open = matches;
    };
    const syncMarginNotes = (matches: boolean) => {
      marginNotes.forEach((note) => (note.open = matches));
    };
    syncTableOfContents(wideOutline.matches);
    syncMarginNotes(wideMargins.matches);
    wideOutline.addEventListener('change', (event) => syncTableOfContents(event.matches));
    wideMargins.addEventListener('change', (event) => syncMarginNotes(event.matches));
  </script>
</BaseLayout>
