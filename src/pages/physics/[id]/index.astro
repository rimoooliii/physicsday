---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GiscusPanel from '../../../components/GiscusPanel.astro';
import { withBase } from '../../../lib/site';
export async function getStaticPaths() {
  const entries = await getCollection('physics', ({data}) => data.status !== 'draft');
  return entries.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'physics'> };
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const articlePath = `/physics/${entry.data.id}/`;
const markdownUrl = new URL(withBase(`/physics/${entry.data.id}.md`, base), Astro.site);
const jsonUrl = new URL(withBase(`/physics/${entry.data.id}.json`, base), Astro.site);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} canonicalPath={articlePath}>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} />
  <link slot="head" rel="alternate" type="application/json" href={jsonUrl} />
  <article class="article-shell">
    <header class="article-header">
      <div class="fracture-rule"><span></span></div>
      <p class="mono article-id">{entry.data.id}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <dl class="metadata"><div><dt>Date</dt><dd>{entry.data.date.toISOString().slice(0,10)}</dd></div><div><dt>Kind</dt><dd>{entry.data.entry_kind}</dd></div><div><dt>Level</dt><dd>{entry.data.level}</dd></div><div><dt>Time</dt><dd>{entry.data.estimated_minutes} min</dd></div></dl>
      {entry.data.status !== 'published' && <aside class={`lifecycle ${entry.data.status}`}>This record is {entry.data.status}.</aside>}
    </header>
    <div class="article-body" data-pagefind-body><Content /></div>
    <footer class="article-tools">
      <h2>Use this record elsewhere</h2>
      <p>Reference <strong>{entry.data.id}</strong> or its permanent URL in a new AI conversation.</p>
      <div class="tool-links"><a href={markdownUrl}>Source Markdown</a><a href={jsonUrl}>Machine-readable JSON</a></div>
    </footer>
    <GiscusPanel />
  </article>
</BaseLayout>
